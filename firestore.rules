rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        request.auth.token.firebase.sign_in_provider == 'password'
        );
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin = existe /admins/{uid} (criado pelo console do Firebase).
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cooperativa (tenant) do usuário, lida de users/{uid}.
    function myTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    function belongsToTenant(dataTenantId) {
      // Exige ser dono da cooperativa ou membro ATIVO da equipe.
      return isSignedIn() && dataTenantId == myTenantId() &&
        (donoDoTenant(dataTenantId) || membroDoTenant(dataTenantId));
    }
    function semTenant(data) {
      return !('tenantId' in data) || data.tenantId == null || data.tenantId == '';
    }
    function donoDoTenant(tenantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/tenantOwners/$(tenantId)) &&
        get(/databases/$(database)/documents/tenantOwners/$(tenantId)).data.ownerUid == request.auth.uid;
    }

    // Equipe: tenantMembers/{email} gravado pelo dono/gestor em Configurações → Usuários.
    function emailDoLogin() {
      return request.auth.token.email.lower();
    }
    function vinculoEquipe() {
      return get(/databases/$(database)/documents/tenantMembers/$(emailDoLogin())).data;
    }
    function membroDoTenant(tenantId) {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        exists(/databases/$(database)/documents/tenantMembers/$(emailDoLogin())) &&
        vinculoEquipe().tenantId == tenantId &&
        vinculoEquipe().active != false &&
        (request.auth.token.email_verified == true || vinculoEquipe().get('authUid', '') == request.auth.uid);
    }
    // Pode gerenciar a equipe: dono ou membro com perfil de gestão.
    function gestorDoTenant(tenantId) {
      return donoDoTenant(tenantId) ||
        (membroDoTenant(tenantId) && vinculoEquipe().role in ['ADMIN', 'PRESIDENTE', 'DIRETOR_FINANCEIRO']);
    }
    function tenantLiberado(data) {
      return semTenant(data) || donoDoTenant(data.tenantId) || membroDoTenant(data.tenantId);
    }
    function cadastroRHValido(data) {
      return data.nome is string && data.nome.size() > 0 && data.nome.size() <= 120;
    }

    // Cargos e Departamentos são comuns a todas as cooperativas.
    function vinculadoAAlgumaCooperativa() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myTenantId() is string && myTenantId() != '';
    }
    function semUsoRegistradoRH(colecao, itemId) {
      return !exists(/databases/$(database)/documents/usoCadastrosRH/$(colecao + '__' + itemId)) ||
        get(/databases/$(database)/documents/usoCadastrosRH/$(colecao + '__' + itemId)).data.get('tenants', {}).size() == 0;
    }

    // Padrão: tudo negado. Cada coleção usada pelo app tem regra explícita abaixo.
    match /{document=**} {
      allow read, write: if false;
    }

    // Portal do Cooperado
    match /portalCooperados/{docId} {
      allow read: if (isSignedIn() && request.auth.token.email_verified == true &&
        resource.data.cooperadoEmail == request.auth.token.email.lower()) ||
        isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update: if (isAdmin() || belongsToTenant(request.resource.data.tenantId)) &&
        docId == request.resource.data.tenantId + '__' + request.resource.data.cooperadoId;
      allow delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
    }

    // App do Produtor
    match /portalProdutores/{docId} {
      allow read: if (isSignedIn() && request.auth.token.email_verified == true &&
        resource.data.produtorEmail == request.auth.token.email.lower()) ||
        isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update: if (isAdmin() || belongsToTenant(request.resource.data.tenantId)) &&
        docId == request.resource.data.tenantId + '__' + request.resource.data.produtorId;
      allow delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
    }

    // Ofertas feitas pelo produtor
    match /portalProdutoresOfertas/{docId} {
      allow create: if isSignedIn() && request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(['tenantId', 'produtorId', 'produtorEmail', 'tipo', 'ofertaId', 'dados', 'criadoEm']) &&
        request.resource.data.produtorEmail == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/portalProdutores/$(request.resource.data.tenantId + '__' + request.resource.data.produtorId)).data.produtorEmail == request.auth.token.email.lower() &&
        (request.resource.data.tipo == 'nova' ||
        (request.resource.data.tipo == 'alterar' && request.resource.data.ofertaId in get(/databases/$(database)/documents/portalProdutores/$(request.resource.data.tenantId + '__' + request.resource.data.produtorId)).data.ofertaIds));
      allow read, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow update: if false;
    }

    // Portal do Motorista
    match /portalMotoristas/{docId} {
      allow read: if (isSignedIn() && request.auth.token.email_verified == true &&
        resource.data.motoristaEmail == request.auth.token.email.lower()) ||
        isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update: if (isAdmin() || belongsToTenant(request.resource.data.tenantId)) &&
        docId == request.resource.data.tenantId + '__' + request.resource.data.motoristaId;
      allow delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
    }

    // Entregas confirmadas pelo motorista
    match /portalMotoristasAtualizacoes/{docId} {
      allow create: if isSignedIn() && request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(['tenantId', 'motoristaId', 'motoristaEmail', 'programacaoId', 'alteracoes', 'criadoEm']) &&
        request.resource.data.motoristaEmail == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/portalMotoristas/$(request.resource.data.tenantId + '__' + request.resource.data.motoristaId)).data.motoristaEmail == request.auth.token.email.lower() &&
        request.resource.data.programacaoId in get(/databases/$(database)/documents/portalMotoristas/$(request.resource.data.tenantId + '__' + request.resource.data.motoristaId)).data.rotaIds;
      allow read, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow update: if false;
    }

    // Portal da Escola
    match /portalEscolas/{docId} {
      allow read: if (isSignedIn() && request.auth.token.email_verified == true &&
        resource.data.escolaEmail == request.auth.token.email.lower()) ||
        isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create, update: if (isAdmin() || belongsToTenant(request.resource.data.tenantId)) &&
        docId == request.resource.data.tenantId + '__' + request.resource.data.escolaId;
      allow delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
    }

    // Comprovantes de entrega registrados pela escola
    match /portalEscolasComprovantes/{docId} {
      allow create: if isSignedIn() && request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(['tenantId', 'escolaId', 'escolaEmail', 'entrega', 'criadoEm']) &&
        request.resource.data.escolaEmail == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/portalEscolas/$(request.resource.data.tenantId + '__' + request.resource.data.escolaId)).data.escolaEmail == request.auth.token.email.lower();
      allow read, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow update: if false;
    }

    // Admins: cada usuário só verifica o próprio status
    match /admins/{userId} {
      allow read: if isCurrentUser(userId);
      allow write: if false;
    }

    // Dono de cada cooperativa, registrado uma única vez pelo próprio dono
    match /tenantOwners/{tenantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // users/{uid}: vínculo usuário → cooperativa (o tenantId não pode ser trocado)
    match /users/{userId} {
      allow read: if isCurrentUser(userId) || isAdmin();
      allow create: if isAdmin() || (isCurrentUser(userId) && tenantLiberado(request.resource.data));
      allow update: if isAdmin() ||
        (isCurrentUser(userId) && request.resource.data.tenantId == resource.data.tenantId) ||
        (isCurrentUser(userId) && semTenant(resource.data) && tenantLiberado(request.resource.data));
      allow delete: if isAdmin();
    }

    // Equipe da cooperativa (Configurações → Usuários)
    match /tenantMembers/{email} {
      allow read: if (isSignedIn() && ('email' in request.auth.token) && emailDoLogin() == email) ||
        isAdmin() || belongsToTenant(resource.data.tenantId) || donoDoTenant(resource.data.tenantId);
      allow create: if isAdmin() ||
        (email == request.resource.data.email && gestorDoTenant(request.resource.data.tenantId));
      allow update: if isAdmin() ||
        (email == request.resource.data.email &&
        request.resource.data.tenantId == resource.data.tenantId &&
        gestorDoTenant(resource.data.tenantId));
      allow delete: if isAdmin() || gestorDoTenant(resource.data.tenantId);
    }

    // Departamentos (comuns a todas as cooperativas)
    match /departamentos/{departamentoId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (belongsToTenant(request.resource.data.tenantId) && cadastroRHValido(request.resource.data));
      allow update: if isAdmin() ||
        (vinculadoAAlgumaCooperativa() &&
        request.resource.data.get('tenantId', null) == resource.data.get('tenantId', null) &&
        cadastroRHValido(request.resource.data));
      allow delete: if isAdmin() || (vinculadoAAlgumaCooperativa() && semUsoRegistradoRH('departamentos', departamentoId));
    }

    // Cargos (comuns a todas as cooperativas)
    match /cargos/{cargoId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (belongsToTenant(request.resource.data.tenantId) && cadastroRHValido(request.resource.data));
      allow update: if isAdmin() ||
        (vinculadoAAlgumaCooperativa() &&
        request.resource.data.get('tenantId', null) == resource.data.get('tenantId', null) &&
        cadastroRHValido(request.resource.data));
      allow delete: if isAdmin() || (vinculadoAAlgumaCooperativa() && semUsoRegistradoRH('cargos', cargoId));
    }

    // Uso de cada cargo/departamento por cooperativa
    match /usoCadastrosRH/{usoId} {
      allow read: if isSignedIn();
      allow create: if vinculadoAAlgumaCooperativa() &&
        request.resource.data.keys().hasOnly(['colecao', 'itemId', 'tenants']) &&
        request.resource.data.colecao in ['departamentos', 'cargos'] &&
        usoId == request.resource.data.colecao + '__' + request.resource.data.itemId &&
        request.resource.data.tenants.keys().hasOnly([myTenantId()]);
      allow update: if vinculadoAAlgumaCooperativa() &&
        request.resource.data.keys().hasOnly(['colecao', 'itemId', 'tenants']) &&
        request.resource.data.colecao == resource.data.colecao &&
        request.resource.data.itemId == resource.data.itemId &&
        request.resource.data.tenants.diff(resource.data.get('tenants', {})).affectedKeys().hasOnly([myTenantId()]);
      allow delete: if isAdmin();
    }

    // Diagnóstico de conexão: cada usuário grava e lê só o próprio documento
    match /diagnostico/{userId} {
      allow read, write: if isCurrentUser(userId);
    }

    // Cooperados
    match /cooperados/{cooperadoId} {
      allow read, update, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if isAdmin() || belongsToTenant(request.resource.data.tenantId);
    }

    // Transações de Capital Social
    match /transacoesCapital/{transacaoId} {
      allow read, update, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if isAdmin() || belongsToTenant(request.resource.data.tenantId);
    }

    // Contas Financeiras (SisFin)
    match /contasFinanceiras/{contaId} {
      allow read, update, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if isAdmin() || belongsToTenant(request.resource.data.tenantId);
    }

    // Assembleias
    match /assembleias/{assembleiaId} {
      allow read, update, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if isAdmin() || belongsToTenant(request.resource.data.tenantId);
    }

    // Histórico de Backups
    match /backups/{backupId} {
      allow read: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if isAdmin() || belongsToTenant(request.resource.data.tenantId);
      allow update, delete: if isAdmin();
    }

    // Cadastro da cooperativa
    match /tenants/{tenantId} {
      allow read, update: if isAdmin() || belongsToTenant(tenantId);
      allow create: if isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        tenantId == myTenantId()
        );
      allow delete: if isAdmin();
    }

    // NOVO — Todos os dados da cooperativa (cadastros, financeiro, contábil,
    // estoque, compras, vendas, PAA/PNAE, RH...), um documento por registro,
    // gravados automaticamente pelo app. id = <tenantId>__<colecao>__<registroId>
    match /dadosCooperativa/{docId} {
      allow read, delete: if isAdmin() || belongsToTenant(resource.data.tenantId);
      allow create: if (isAdmin() || belongsToTenant(request.resource.data.tenantId)) &&
        request.resource.data.colecao is string &&
        request.resource.data.registroId is string &&
        request.resource.data.json is string &&
        docId == request.resource.data.tenantId + '__' + request.resource.data.colecao + '__' + request.resource.data.registroId;
      allow update: if (isAdmin() || belongsToTenant(resource.data.tenantId)) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.colecao == resource.data.colecao &&
        request.resource.data.registroId == resource.data.registroId &&
        request.resource.data.json is string;
    }

    // Assinaturas e logs de webhook: só o backend (credencial de serviço)
    match /assinaturas/{email} {
      allow read, write: if false;
    }

    match /webhookLogs/{logId} {
      allow read, write: if false;
    }

    // Teste de conexão: só leitura
    match /test/connection {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
