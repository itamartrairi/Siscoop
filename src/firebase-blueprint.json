{
  "entities": {
    "Cooperado": {
      "title": "Cooperado",
      "description": "Cadastro e ficha cadastral do cooperado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "nome": { "type": "string" },
        "matricula": { "type": "string" },
        "cpf": { "type": "string" },
        "rg": { "type": "string" },
        "dataAdmissao": { "type": "string" },
        "situacao": { "type": "string" },
        "capitalSubscrito": { "type": "number" },
        "capitalIntegralizado": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nome", "matricula", "cpf"]
    },
    "TransacaoCapital": {
      "title": "TransacaoCapital",
      "description": "Lançamento de movimentação de cota-parte e capital social",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cooperadoId": { "type": "string" },
        "cooperadoNome": { "type": "string" },
        "tipo": { "type": "string" },
        "valor": { "type": "number" },
        "data": { "type": "string" },
        "formaPagamento": { "type": "string" },
        "numeroDocumento": { "type": "string" }
      },
      "required": ["id", "cooperadoId", "tipo", "valor"]
    },
    "ContaFinanceira": {
      "title": "ContaFinanceira",
      "description": "Conta a pagar ou a receber do SisFin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "tipo": { "type": "string" },
        "descricao": { "type": "string" },
        "valor": { "type": "number" },
        "dataVencimento": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "tipo", "descricao", "valor", "status"]
    },
    "Assembleia": {
      "title": "Assembleia",
      "description": "Registro de assembleia geral e votações",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "tipo": { "type": "string" },
        "data": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "titulo", "status"]
    },
    "BackupRecord": {
      "title": "BackupRecord",
      "description": "Registro de backup do sistema e cópia de segurança em nuvem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "tipo": { "type": "string" },
        "status": { "type": "string" },
        "arquivosCount": { "type": "number" },
        "tamanhoTotalBytes": { "type": "number" },
        "menssagem": { "type": "string" }
      },
      "required": ["id", "timestamp", "status"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Cadastro e dados da Cooperativa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "razaoSocial": { "type": "string" }
      },
      "required": ["id", "name", "cnpj"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Documento de autorização de administradores",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/cooperados/{cooperadoId}": {
      "schema": "Cooperado",
      "description": "Coleção de cooperados cadastrados na cooperativa"
    },
    "/transacoesCapital/{transacaoId}": {
      "schema": "TransacaoCapital",
      "description": "Movimentações de cotas-partes e capital social"
    },
    "/contasFinanceiras/{contaId}": {
      "schema": "ContaFinanceira",
      "description": "Contas a pagar e a receber do módulo financeiro"
    },
    "/assembleias/{assembleiaId}": {
      "schema": "Assembleia",
      "description": "Assembleias gerais e pautas de deliberação"
    },
    "/backups/{backupId}": {
      "schema": "BackupRecord",
      "description": "Histórico de backups gravados no Firestore"
    },
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Informações da cooperativa multilocatária"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Mapeamento de usuários administradores da plataforma"
    }
  }
}
