# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA versione o arquivo preenchido.
# ---------------------------------------------------------------------------

# Segredo do webhook, em "Kiwify > Configurações > Webhooks".
# Sem ele o servidor rejeita TODOS os webhooks, inclusive em desenvolvimento.
# Isso é proposital: um webhook não verificado ativa licença de graça.
KIWIFY_WEBHOOK_SECRET=""

# Token dos endpoints de diagnóstico (/api/webhooks/kiwify e .../history).
# Gere com: openssl rand -hex 32
# Sem ele os endpoints respondem 503 em vez de expor dados de clientes.
ADMIN_API_TOKEN=""

# Credencial de serviço do Firebase, como JSON em UMA linha.
# Usada para verificar ID tokens e gravar assinaturas no Firestore.
# Em Cloud Run / GCE pode ficar vazio: as credenciais padrão do ambiente valem.
FIREBASE_SERVICE_ACCOUNT=""

# ID do banco Firestore, se não for o "(default)".
FIRESTORE_DATABASE_ID=""

# Porta do servidor (padrão 3000).
PORT="3000"

# Endpoint de simulação de compra. Só funciona com NODE_ENV != production.
ENABLE_TEST_ENDPOINTS="false"

# Chave da API Gemini, se os recursos de IA forem usados.
GEMINI_API_KEY=""

# URL pública da aplicação, para links e QR codes dos portais.
APP_URL=""
